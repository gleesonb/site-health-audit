{
  "_comment": "Maps squirrelscan rule ids to a business priority for a small marketing or club website. Tier 1 = fix now, 2 = fix soon, 3 = worth a look. Rules not listed fall back to their category default. Any rule squirrelscan reports at severity 'error' is raised to at least tier 2. Edit this file to change priorities; the reasons are in references/priorities.md.",
  "schemaVersion": "1",
  "tiers": {
    "1": {
      "label": "Fix now",
      "meaning": "These can stop search engines finding or listing your pages, break things visitors use, or make the site look unsafe."
    },
    "2": {
      "label": "Fix soon",
      "meaning": "These cost you search clicks, speed, shares or accessibility, but nothing is broken outright."
    },
    "3": {
      "label": "Worth a look",
      "meaning": "Polish and judgement calls. Fix them when convenient, or decide they do not apply."
    }
  },
  "messageOverrides": [
    {"rule": "core/meta-title", "pattern": "too (long|short)", "tier": 3, "why": "Length nags; a missing or duplicate title stays urgent."},
    {"rule": "core/meta-description", "pattern": "too (long|short)", "tier": 3, "why": "Google rewrites descriptions freely; a missing one still matters."},
    {"rule": "images/image-file-size", "pattern": "exceed 200(\\.0)? ?KB", "tier": 3, "why": "Only images over 1 MB hurt enough to act on first."}
  ],
  "duplicateOf": {
    "_comment": "Drop the key's finding when the value's finding is also present; squirrelscan reports these twice.",
    "core/title-unique": "content/duplicate-title"
  },
  "categoryDefaults": {
    "crawl": 2,
    "core": 2,
    "links": 2,
    "security": 3,
    "perf": 2,
    "images": 3,
    "schema": 3,
    "content": 3,
    "a11y": 3,
    "mobile": 2,
    "reliability": 1,
    "legal": 2,
    "social": 3,
    "eeat": 3,
    "ax": 3,
    "url": 3,
    "i18n": 3,
    "local": 3,
    "video": 3,
    "analytics": 3,
    "integrity": 3
  },
  "rules": {
    "crawl/indexability": 1,
    "crawl/all-noindex-pages": 1,
    "crawl/noindex-in-sitemap": 1,
    "crawl/robots-txt": 1,
    "crawl/robots-meta-conflict": 1,
    "crawl/indexability-conflicts": 1,
    "crawl/canonical-chain": 1,
    "crawl/schema-noindex-conflict": 1,
    "crawl/soft-404": 1,
    "crawl/sitemap-exists": 1,
    "crawl/sitemap-valid": 1,
    "crawl/sitemap-4xx": 1,
    "crawl/sitemap-domain": 1,
    "crawl/redirect-chain": 1,
    "core/canonical": 1,
    "core/robots-meta": 1,
    "core/meta-title": 1,
    "core/title-unique": 1,
    "content/duplicate-title": 1,
    "links/broken-links": 1,
    "links/invalid-links": 1,
    "links/redirect-chains": 1,
    "links/https-downgrade": 1,
    "security/https": 1,
    "security/http-to-https": 1,
    "security/mixed-content": 1,
    "security/tls-certificate": 1,
    "security/leaked-secrets": 1,
    "security/form-https": 1,
    "images/broken-images": 1,
    "mobile/viewport": 1,
    "content/dev-leakage": 1,
    "content/placeholder-text": 1,
    "content/placeholder-contact": 1,
    "content/placeholder-media": 1,
    "content/unrendered-markup": 1,
    "content/mojibake": 1,

    "core/meta-description": 2,
    "content/duplicate-description": 2,
    "core/h1": 2,
    "core/og-tags": 2,
    "social/og-image-size": 2,
    "schema/json-ld-valid": 2,
    "schema/organization": 2,
    "schema/expected-type": 2,
    "schema/entity-organization-missing": 2,
    "schema/entity-website-missing": 2,
    "schema/breadcrumb": 2,
    "images/image-file-size": 2,
    "images/responsive-size": 2,
    "images/modern-format": 2,
    "images/dimensions": 2,
    "images/alt-text": 2,
    "content/word-count": 2,
    "content/thin-vs-site-norm": 2,
    "a11y/form-labels": 2,
    "a11y/button-name": 2,
    "a11y/link-text": 2,
    "a11y/color-contrast": 2,
    "a11y/aria-input-field-name": 2,
    "a11y/zoom-disabled": 2,
    "security/hsts": 2,
    "security/cookie-flags": 2,
    "eeat/privacy-policy": 2,
    "eeat/contact-page": 2,

    "perf/unminified-js": 3,
    "perf/unminified-css": 3,
    "perf/dom-size": 3,
    "perf/source-maps": 3,
    "perf/js-libraries": 3,
    "perf/legacy-js": 3,
    "perf/duplicate-js": 3,
    "perf/http2": 3,
    "perf/animated-content": 3,
    "crawl/html-size": 3,
    "crawl/pdf-size": 3,
    "core/twitter-cards": 3,
    "core/favicon": 3,
    "links/nofollow-internal": 3,
    "links/anchor-text": 3,
    "links/tel-mailto": 3,
    "mobile/web-app-manifest": 3,
    "legal/subprocessor-disclosure": 3
  }
}
